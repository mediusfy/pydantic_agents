# Provider selection: deepseek, gemini, vertexai, openai, litellm (default)
MODEL_PROVIDER=litellm

# LiteLLM proxy (used when MODEL_PROVIDER=litellm)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_VIRTUAL_KEY=
LITELLM_ENV=local
LITELLM_CLOUD_URL=

# Direct provider keys (used for native/non-litellm routing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Observability. Langfuse keys export the in-process span tree (agent runs, tools, model calls) to
# ${LANGFUSE_HOST}/api/public/otel; a Logfire token exports it to Logfire cloud. Either, both, or none.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOGFIRE_TOKEN=
LOGFIRE_API_KEY=

# Per-request HTTP timeout on the model client and the output cap sent with every call.
# AGENT_HTTP_TIMEOUT_SECONDS=300
# AGENT_MAX_OUTPUT_TOKENS=16384

# Vector store: EMBEDDING_PROVIDER=litellm embeds through the proxy (re-seed after changing provider/model/dim).
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# RERANK_MODEL=
# RETRIEVAL_HYBRID=true

# Push activity logs into the local Claude Code / Antigravity memory directories after a run (off by default).
# MEMORY_BRIDGE_SYNC=false

# Run limits. LiteLLM retries and falls back, so keep the agent-side transport retry at 1.
# AGENT_TRANSPORT_ATTEMPTS=1
# Per-agent model override (a real LiteLLM model group the key may call), e.g.
# BACKEND_MODEL=deepseek-v4-pro
# DOCS_MODEL=subagent
